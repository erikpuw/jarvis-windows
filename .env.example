# Required API Keys http://127.0.0.1:8080/v1 headroom http://127.0.0.1:8787/v1
LOCAL_API_KEY=
LOCAL_URL=http://127.0.0.1:8080/v1
LOCAL_MODEL=Qwen3.5-9B-DeepSeek-V4-Flash-Q4_K_M.gguf

# Model Switch Configuration (false = Qwen3.5, true = Gemma4)
CHANG_MODEL=true
LOCAL_GEMMA_MODEL=gemma-4-E4B-QAT-Q4_K_XL

# Bonsai 2 27B (ternary) - true = dùng Bonsai, ưu tiên hơn CHANG_MODEL. Đặt false để quay lại gemma4.
BONSAI_MODEL=false
LOCAL_BONSAI_MODEL=Ternary-Bonsai-2-27B-PTQ1_0

# LLM EMBED
LOCAL_EMBED_URL=http://127.0.0.1:8081/v1
LOCAL_EMBED_MODEL=run_llama-multilingual-e5-large-q4_k_m
LOCAL_EMBED_API=

# TTS (edge-tts trực tiếp, cần internet)
TTS_LOCAL_MODEL=vi-VN-NamMinhNeural
TTS_LOCAL_URL=http://127.0.0.1:20128/v1/audio/speech
# TTS_ENGINE được giữ để tương thích cấu hình cũ; lựa chọn engine dùng hai cờ bên dưới.
TTS_ENGINE=stream
TTS_STREAM_URL=http://127.0.0.1:8082
VIENEU_TTS_ENABLED=true
EDGE_TTS_ENABLED=false
# Tên preset v3 (vd: Minh Quân, Mai Anh, Trúc Ly). Để trống = Minh Quân
VIENEU_VOICE_ID=Adam
# 1 = VieNeu chỉ nạp model từ cache, không gọi Hugging Face lúc khởi động. Đặt 0 rồi khởi động lại khi cần cập nhật model/SDK.
VIENEU_HF_OFFLINE=1
VIENEU_MAX_STREAMS=1
VIENEU_FUSED_FRAME=1
VIENEU_WARMUP=1

# Vision model: để trống (hoặc "auto") = đi theo model chat đang chạy (Qwen/Gemma/Bonsai); đặt tên cụ thể nếu muốn cố định
VISION_API_KEY=
VISION_MODEL=gemma-4-E4B-QAT-Q4_K_XL
VISION_URL=http://127.0.0.1:8080/v1

# context limit
LOCAL_CONTEXT_WINDOW=16384

# Điều khiển máy (@control): cua-driver, chạy nền (không chiếm chuột), dùng model chat đang chạy.
# CUA_DRIVER_PATH trống = tự tìm trong PATH rồi %LOCALAPPDATA%\Programs\Cua\cua-driver\bin.
# CUA_CONFIRM: each = xác nhận từng thao tác thay đổi máy (mặc định) | off = không hỏi (nút Delete/Uninstall/Xóa… vẫn hỏi)
CUA_DRIVER_PATH=
CUA_CONFIRM=each
CUA_MAX_STEPS=12

# Optional: Your name (JARVIS will address you by name)
USER_NAME=erikpuw
HONORIFIC=ngài
CALENDAR_ACCOUNTS=auto

# Redis 
REDIS_URL=redis://127.0.0.1:6379/0

# JARVIS Security Controls
JARVIS_SECURITY_LOCAL_ONLY=true
JARVIS_SECURITY_LAN_OPEN=true
JARVIS_CORS_ORIGINS=*
JARVIS_SECURITY_ALLOWED_IPS=127.0.0.1,::1

TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

MEMORY_PASSWORD=1234 <= set pass here unlock memory history in frontend
CONTEXT7_API_KEY=
