# =============================================================================
# JARVIS — mẫu cấu hình môi trường
# Copy thành .env rồi điền giá trị:  Copy-Item .env.example .env
# (server.py cũng tự copy file này thành .env nếu chưa có .env)
# KHÔNG commit .env — file đó chứa API key và đã nằm trong .gitignore.
# =============================================================================

# --- Cá nhân hóa ---
# Chỉ trang Settings lưu/hiển thị hai biến này. Xưng hô khi trò chuyện ("tôi" - "ngài") nằm ở prompt/identity.md và prompt/user.md.
USER_NAME=
HONORIFIC=thưa ngài

# --- LLM (llama.cpp / endpoint tương thích OpenAI) ---
LOCAL_URL=http://localhost:8080/v1
LOCAL_API_KEY=sk-no-key-required
LOCAL_MODEL=
LOCAL_LLM_TIMEOUT_SECONDS=180
LLM_MAX_BACKGROUND_CALLS=1
# Chọn model chat: BONSAI_MODEL=true → LOCAL_BONSAI_MODEL; CHANG_MODEL=true → LOCAL_GEMMA_MODEL;
# cả hai false → LOCAL_MODEL. Ưu tiên: bonsai > gemma > LOCAL_MODEL.
CHANG_MODEL=false
LOCAL_GEMMA_MODEL=
BONSAI_MODEL=false
LOCAL_BONSAI_MODEL=

# --- Embeddings (RAG, semantic memory) ---
LOCAL_EMBED_URL=http://localhost:8081/v1
LOCAL_EMBED_API=sk-no-key-required
LOCAL_EMBED_MODEL=nomic-embed-text-v1.5-q8_0
LOCAL_EMBED_TIMEOUT_SECONDS=30

# --- Vision (đọc màn hình, OCR PDF scan) ---
VISION_URL=
VISION_API_KEY=
VISION_MODEL=

# --- TTS: chỉ bật MỘT trong hai engine ---
EDGE_TTS_ENABLED=true
VIENEU_TTS_ENABLED=false
TTS_ENGINE=edge
TTS_LOCAL_MODEL=vi-VN-NamMinhNeural
TTS_LOCAL_URL=
TTS_LOCAL_KEY=
TTS_STREAM_URL=http://127.0.0.1:8082
TTS_PREFETCH_DEPTH=3
TTS_PREFETCH_GAP_SECONDS=0.25
TTS_SENTENCE_GAP_SECONDS=0.08
TTS_RETRY_BACKOFF_SECONDS=0.6
# VieNeu (khi VIENEU_TTS_ENABLED=true)
VIENEU_VOICE_ID=
VIENEU_HF_OFFLINE=1
VIENEU_MAX_STREAMS=2
VIENEU_PAUSE_SCALE=1.6
VIENEU_SENTENCE_PAUSE_MS=450

# Stream TTS chạy riêng bằng run_vieneu.py
STREAM_TTS_HOST=127.0.0.1
STREAM_TTS_PORT=8082

# --- STT (faster-whisper): tiny | base | small | medium | large-v3 ---
WHISPER_MODEL_SIZE=base

# --- Server & bảo mật ---
JARVIS_SERVER_PORT=8340
# true = chỉ cho máy này (loopback) kết nối
JARVIS_SECURITY_LOCAL_ONLY=true
# Chỉ có tác dụng khi LOCAL_ONLY=false: cho phép mọi IP mạng nội bộ
JARVIS_SECURITY_LAN_OPEN=false
# IP/CIDR được phép thêm, phân cách dấu phẩy (vd. 100.64.0.0/10 cho Tailscale)
JARVIS_SECURITY_ALLOWED_IPS=
# Origin trình duyệt được phép gọi API/WebSocket, phân cách dấu phẩy. "*" bị bỏ qua.
# Để trống = localhost:5173 và localhost:8340. Vd điện thoại qua Tailscale: http://100.x.y.z:5173
JARVIS_CORS_ORIGINS=
JARVIS_UPLOAD_MAX_BYTES=26214400
JARVIS_STT_MAX_BYTES=20971520
INPUT_CHANNEL_WAIT_SECONDS=25

# --- Khoá Bộ nhớ / Lịch sử chat / Nhật ký trong Settings ---
# Để trống = các trang này khoá hẳn. Không có API nào đặt hay đổi mật khẩu, chỉ sửa ở đây.
MEMORY_PASSWORD=

# --- Redis (hàng đợi job nền) ---
REDIS_URL=redis://localhost:6379

# --- RAG ---
RAG_WATCH_FOLDER=data/documents
RAG_MIN_SCORE=0.2

# --- Dream (tự tổng hợp bộ nhớ ban đêm) ---
DREAM_ENABLED=true
DREAM_RETENTION_DAYS=14
# Số ngày giữ agent_outcomes thành công (lỗi giữ gấp đôi); bỏ dòng này = bằng DREAM_RETENTION_DAYS
# DREAM_OUTCOME_RETENTION_DAYS=14
DREAM_QUIET_HOUR_START=2
DREAM_QUIET_HOUR_END=5
DREAM_INTERVAL_HOURS=24

# --- Telegram (tùy chọn) ---
TELEGRAM_BOT_TOKEN=
# Chat ID được phép, phân cách dấu phẩy
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_GROUP_REQUIRE_MENTION=true

# --- Gmail (gửi thư ứng tuyển; dùng App Password, không dùng mật khẩu thật) ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Điều khiển Windows (cua-driver) ---
CUA_DRIVER_PATH=
# each = hỏi xác nhận mỗi bước | off = không hỏi
CUA_CONFIRM=each
CUA_MAX_STEPS=12
CALENDAR_ACCOUNTS=
